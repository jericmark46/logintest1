# MongoDB connection string (Atlas in production, local mongod in development)
MONGODB_URI=mongodb://127.0.0.1:27017/mern_auth

# Long random string used to sign JWTs (required)
JWT_SECRET=change-me-to-a-long-random-string

# Optional (defaults shown)
PORT=5000
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins. Defaults to * when unset.
CLIENT_ORIGIN=http://localhost:5173
